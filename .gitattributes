# Normalize all text files to LF in the repository; explicit exceptions below.
* text=auto eol=lf

# Binary assets: never apply text conversion.
*.docx binary
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.ico binary

# Windows scripts must stay CRLF.
*.ps1 eol=crlf
*.bat eol=crlf
*.cmd eol=crlf

# QA evidence is byte-exact and hash-referenced; never normalize it.
docs/qa/** -text

# Shell scripts run inside Linux containers — must keep LF line endings
# even when the working tree is checked out on Windows.
*.sh text eol=lf
# Keep catalog fingerprints and SQL migration sources identical across platforms.
db/schema.sql text eol=lf
db/migrations/*.sql text eol=lf
# The formatter checks the same text on Windows and Linux.
frontend/**/*.js text eol=lf
frontend/**/*.jsx text eol=lf
frontend/**/*.json text eol=lf
frontend/**/*.css text eol=lf
frontend/**/*.html text eol=lf
frontend/.prettierignore text eol=lf
