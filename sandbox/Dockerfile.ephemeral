FROM postgres:17
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && groupmod -g 10001 postgres && usermod -u 10001 -g 10001 postgres
COPY backend/requirements.txt /tmp/runner-requirements.txt
RUN python3 -m venv /opt/runner && /opt/runner/bin/pip install --no-cache-dir -r /tmp/runner-requirements.txt
COPY backend/app /srv/DBCAS/backend/app
COPY sandbox/init /docker-entrypoint-initdb.d
ENV PYTHONPATH=/srv/DBCAS/backend PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
LABEL com.dbcas.sandbox-protocol="1"
