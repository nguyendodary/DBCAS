# Copy to an ignored .env file, replace every placeholder, and never commit it.
DBCAS_RELEASE_ENV_FILE=deploy/.env
DBCAS_RELEASE_HTTP_PORT=8080
DEPLOYMENT_MODE=production
POSTGRES_USER=dbcas
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=dbcas
DATABASE_URL=postgresql://dbcas:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@db:5432/dbcas
SANDBOX_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SANDBOX_ADMIN_PASSWORD
SANDBOX_LEARNER_PASSWORD=REPLACE_WITH_RANDOM_SANDBOX_LEARNER_PASSWORD
SANDBOX_ADMIN_URL=postgresql://postgres:REPLACE_WITH_RANDOM_SANDBOX_ADMIN_PASSWORD@sandbox:5432/postgres
SANDBOX_URL=postgresql://learner_ro:REPLACE_WITH_RANDOM_SANDBOX_LEARNER_PASSWORD@sandbox:5432/postgres
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ALGORITHM=HS256
FRONTEND_URL=https://assessment.example.edu
CORS_ORIGINS=["https://assessment.example.edu"]
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_SESSION_MAX_MINUTES=480
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_TIMEOUT_SECONDS=5
READINESS_DATABASE_TIMEOUT_SECONDS=2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://assessment.example.edu/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://assessment.example.edu/api/v1/auth/oauth/github/callback
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
# Self-service password recovery — point at a real SMTP relay. When SMTP_HOST
# or SMTP_FROM is empty the reset endpoint answers 503 (recovery disabled),
# never falling back to the development Mailpit inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_IP_RATE_LIMIT_ATTEMPTS=20
PASSWORD_RESET_CONFIRM_RATE_LIMIT_ATTEMPTS=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
