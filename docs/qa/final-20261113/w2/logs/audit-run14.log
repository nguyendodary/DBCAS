      "prompt": "Yêu cầu nghiệp vụ: so sánh tiền của giao dịch với trung bình nhóm. Quy tắc: Truy vấn con tương quan tính trung bình riêng cho nhóm; AVG bỏ qua NULL.\nDữ liệu PostgreSQL cố định (Unicode và định danh cần trích dẫn):\nCREATE TABLE cases(id integer PRIMARY KEY,grp text,n numeric,b numeric,txt text,flag boolean,doc jsonb,arr integer[],day date); INSERT INTO cases VALUES (1,'A',31.25,2,'Đà Nẵng',NULL,'{\"score\": 31.25, \"nullable\": true}','{-1,0}','2024-12-30'),(2,'A',9.95,0,'a\"b',NULL,'{\"nullable\": false}','{0,-1}','2024-12-31'),(3,'A',NULL,NULL,'An',false,'{\"score\": null}','{1,-2}','2025-01-01'),(4,'B',20,3,'a_b',true,'{\"score\": 20, \"nullable\": false}','{}','2025-02-28'),(5,'B',19.99,5,'a%b',NULL,'{\"nullable\": false}',NULL,'2025-03-01'),(6,'B',0,2,NULL,false,'{\"score\": null}','{3,NULL}',NULL);\nTruy vấn dưới đây trả bảng kết quả nào?\nWITH evaluated AS (SELECT id,grp,(n > (SELECT avg(d.n) FROM cases d WHERE d.grp=c.grp))::text AS value FROM cases c), frequencies AS (SELECT grp,value,count(*) AS frequency FROM evaluated GROUP BY grp,value) SELECT grp,value,frequency,dense_rank() OVER(PARTITION BY grp ORDER BY frequency DESC) AS frequency_rank FROM frequencies ORDER BY grp,frequency DESC,value COLLATE \"C\" NULLS LAST\nChọn toàn bộ bảng đúng, kể cả NULL và số lần lặp.",
