digraph pipeline {
graph [rankdir=TB,bgcolor="white",pad="0.5",nodesep="0.5",ranksep="1.2",fontname="Arial",fontsize=22]; node [shape=box,style="rounded,filled",fillcolor="#EFF5FB",color="#1F3864",fontname="Arial",fontsize=13,margin="0.16"]; edge [color="#2E75B6",fontname="Arial",fontsize=11];
graph [label="DBCAS assessment, grading and release lifecycle\nLegacy full-session target: 10 MCQ / 2 SQL / 1 essay; personalized formal / practice plans retain configured constraints\nLong-term learning paths and course-document retrieval remain outside scope",labelloc=t];
"opening" [label="Opening\nLegacy: three MCQs at levels 1-2"];
"grade" [label="Grade each answer\nMCQ / SQL / essay rubric"];
"evidence" [label="Evidence\nRecord result; deterministic estimates"];
"adaptive" [label="Adaptive selection\nAfter opening: 3/3 harder; 2/3 medium;\n0-1/3 basic / weak; type quotas"];
"next" [label="Next item\nServe validated captured question"];
"complete" [label="Complete assessment\nConfigured cap (at most 13) / finish / timer 00:00"];
"candidate" [label="Candidate preparation\nAI draft, checks, administrator approval"];
"bank" [label="Validated item bank\nOnly approved validated items eligible"];
"mode" [label="Assembly policy\nPersonalized or legacy adaptive"];
"plan" [label="Personalized assembly (R1-R3)\nSelected skills + difficulty; frozen plan"];
"pending" [label="Automatic grading pending\nQueued / running bounded jobs"];
"policy" [label="Result release policy (R5)\nAfter automatic grading completes"];
"review" [label="Human verification (R6)\nBounded corrections + immutable audit"];
"publish" [label="Publish results\nImmediate policy or admin publication"];
"competency" [label="Published competency + gaps\nDeterministic session profile + cumulative R7\nGaps ranked by shortfall; concept names / descriptions\nEvidence-linked explanations; no LLM ranking"];
"opening" -> "grade" [id="P01",label="P01 Opening answers"];
"grade" -> "evidence" [id="P02",label="P02 Completed automatic grade"];
"evidence" -> "adaptive" [id="P03",label="P03 Legacy next selection"];
"adaptive" -> "next" [id="P04",label="P04 Selected validated item"];
"next" -> "complete" [id="P05",label="P05 Configured cap / timer / finish"];
"candidate" -> "bank" [id="P06",label="P06 After checks + human approval + validation"];
"bank" -> "adaptive" [id="P07",label="P07 Eligible legacy pool"];
"next" -> "grade" [id="P08",label="P08 Submit answer; repeat"];
"mode" -> "opening" [id="P09",label="P09 Legacy selection"];
"mode" -> "plan" [id="P10",label="P10 Personalized selection"];
"bank" -> "plan" [id="P11",label="P11 Validated matching skill / difficulty pool"];
"plan" -> "next" [id="P12",label="P12 Serve next frozen-plan entry"];
"evidence" -> "next" [id="P13",label="P13 Personalized: next plan item"];
"grade" -> "pending" [id="P14",label="P14 Asynchronous essay / failure retry"];
"pending" -> "evidence" [id="P15",label="P15 Successful bounded job"];
"complete" -> "policy" [id="P16",label="P16 All required automatic grades ready"];
"complete" -> "pending" [id="P17",label="P17 Automatic grades outstanding"];
"pending" -> "policy" [id="P18",label="P18 Finalized and all grades ready"];
"policy" -> "review" [id="P19",label="P19 Manual verification policy"];
"policy" -> "publish" [id="P20",label="P20 Immediate policy"];
"review" -> "reviewed" [id="P21",label="P21 All required reviews complete"];
"publish" -> "competency" [id="P22",label="P22 Published evidence only"];
pending -> review [id="P23", label="P23 Submitted human mode: authorized manual takeover"];
reviewed [label="Reviewed\nRequired reviews complete; not published"];
failed [label="Grading failed\nNo usable grade after bounded attempts"];
reviewed -> publish [id="P24",label="P24 Authorized explicit publication"];
pending -> failed [id="P25",label="P25 Bounded attempts exhausted"];
failed -> pending [id="P26",label="P26 Authorized retry"];
failed -> review [id="P27",label="P27 Submitted human mode: authorized manual takeover"];
}
