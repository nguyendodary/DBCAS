digraph schema {
graph [rankdir=LR,splines=curved,bgcolor="white",pad="0.5",nodesep="0.5",ranksep="1.2",fontname="Arial",fontsize=22]; node [shape=box,style="rounded,filled",fillcolor="#EFF5FB",color="#1F3864",fontname="Arial",fontsize=13,margin="0.16"]; edge [color="#2E75B6",fontname="Arial",fontsize=11];
