digraph components {
graph [rankdir=LR,bgcolor="white",pad="0.5",nodesep="0.65",ranksep="1.1",fontname="Arial",fontsize=22]; node [shape=box,style="rounded,filled",fillcolor="#EFF5FB",color="#1F3864",fontname="Arial",fontsize=13,margin="0.18"]; edge [color="#2E75B6",fontname="Arial",fontsize=10];
graph [label="DBCAS backend responsibilities -\nmultiple boxes may project a shared\nrepository class",labelloc=t];
"c0" [label="Auth controller responsibility\nrouters/auth.py"];
"s0" [label="Auth service\nJWT, password hashing, current-role\nRBAC"];
"r0" [label="AccountRepository\nAccount / Role / AccountRole /\nUserProfile"];
"c1" [label="Assessment controller responsibility\nrouters/admin.py / sessions.py /\nassessments.py"];
"s1" [label="Assessment session service\nTimer, auto-submit, configurable\nduration; max 13"];
"r1" [label="AssessmentRepository\nAssessment / AssessmentConcept /\nAssessmentSession"];
"c2" [label="Curriculum controller responsibility\nrouters/admin.py / sessions.py /\nassessments.py"];
"s2" [label="Curriculum service\nCLO / concepts / rules / mapping\nconfirmation"];
"r2" [label="CurriculumRepository\nCourseLearningOutcome / Concept /\nCLOConcept"];
"c3" [label="Question Bank controller\nresponsibility\nrouters/admin.py / sessions.py /\nassessments.py"];
"s3" [label="Question bank service\nValidated bank curation; tag\nconfirmation"];
"r3" [label="QuestionRepository\nQuestion / QuestionConcept / MCQOption\n/ dataset / rubric"];
"c4" [label="Analytics controller responsibility\nrouters/admin.py / sessions.py /\nassessments.py"];
"s4" [label="Competency & gap service\nDeterministic competency, gaps;\nassistive explanations"];
"r4" [label="CompetencyRepository\nConceptCompetency / CompetencyGap"];
"c5" [label="Attempt controller responsibility\nrouters/admin.py / sessions.py /\nassessments.py"];
"s5" [label="Grading service\nMCQ key / SQL output / rubric essay\ngrades"];
"r5" [label="Attempt access: shared\nAssessmentRepository\nAnswers / score / grading evidence"];
"c6" [label="Candidate controller responsibility\nrouters/admin.py / sessions.py /\nassessments.py"];
"s6" [label="Assessment dispatch + legacy and batch adaptive\nadaptive_engine.py + batch_adaptive.py;\nno AI generation"];
"r6" [label="Selection access: shared\nAssessmentRepository\nSelectionLog / AdaptiveEvent;\ncandidate access separately cr"];
"llm" [label="LLMService gateway\nPII sanitizer / templates / strict\nJSON / LLMCache"];
"db" [label="System PostgreSQL 17\nApplication / evidence / cache"];
"runner" [label="SandboxRunner\nRead-only learner transaction / 3s\ndefault timeout / rollback"];
"provider" [label="External LLM provider\nOptional configured HTTPS"];
"sandbox" [label="Separate SQL sandbox\nPostgreSQL 17"];
"ai" [label="Administrator AI assistance\nai_admin_service.py +\ngoverned_generation.py; human\ncuration gates"];
"cr" [label="Candidate access responsibility\nQuestionRepository (shared class)"];
"life" [label="Assessment lifecycle + grading jobs\nDurable drafts, finalization, bounded\nretry"];
"review" [label="Grading review\nPublication guards; immutable review\naudit"];
"c0" -> "s0" [id="B01",label="B01 Delegates request"];
"s0" -> "r0" [id="B02",label="B02 Persists / reads domain records"];
"r0" -> "db" [id="B03",label="B03 SQLAlchemy database access"];
"c1" -> "s1" [id="B04",label="B04 Delegates request"];
"s1" -> "r1" [id="B05",label="B05 Persists / reads domain records"];
"r1" -> "db" [id="B06",label="B06 SQLAlchemy database access"];
"c2" -> "s2" [id="B07",label="B07 Delegates request"];
"s2" -> "r2" [id="B08",label="B08 Persists / reads domain records"];
"r2" -> "db" [id="B09",label="B09 SQLAlchemy database access"];
"c3" -> "s3" [id="B10",label="B10 Delegates request"];
"s3" -> "r3" [id="B11",label="B11 Persists / reads domain records"];
"r3" -> "db" [id="B12",label="B12 SQLAlchemy database access"];
"c4" -> "s4" [id="B13",label="B13 Delegates request"];
"s4" -> "r4" [id="B14",label="B14 Persists / reads domain records"];
"r4" -> "db" [id="B15",label="B15 SQLAlchemy database access"];
"c5" -> "s5" [id="B16",label="B16 Delegates request"];
"s5" -> "life" [id="B17",label="B17 Submit through\nassessment_lifecycle"];
"r5" -> "db" [id="B18",label="B18 SQLAlchemy database access"];
"s6" -> "r6" [id="B20",label="B20 Persists / reads domain records"];
"r6" -> "db" [id="B21",label="B21 SQLAlchemy database access"];
"llm" -> "db" [id="B22",label="B22 LlmCacheRepository"];
"llm" -> "provider" [id="B23",label="B23 Sanitized task request"];
"runner" -> "sandbox" [id="B24",label="B24 Read-only learner query with\ntimeout"];
"c6" -> "ai" [id="B25",label="B25 Candidate generation / review"];
"ai" -> "cr" [id="B26",label="B26 Candidate storage"];
"cr" -> "db" [id="B27",label="B27 QuestionRepository writes"];
"ai" -> "r2" [id="B28",label="B28 CLO suggestions / confirmed\nmappings"];
"ai" -> "r3" [id="B29",label="B29 Tag suggestions / question\npromotion"];
"ai" -> "llm" [id="B30",label="B30 Assistive structured requests"];
"ai" -> "runner" [id="B31",label="B31 Candidate SQL validation when\nrequired"];
"s1" -> "s6" [id="B32",label="B32 Legacy adaptive selection"];
"s1" -> "life" [id="B33",label="B33 Submission / finish / timeout\norchestration"];
"life" -> "r5" [id="B34",label="B34 Persist answer grade and evidence"];
"s5" -> "llm" [id="B35",label="B35 Essay grading through\nessay_grading.py"];
"s5" -> "runner" [id="B36",label="B36 SQL grading through sql_service.py"];
"s4" -> "llm" [id="B37",label="B37 Gap explanations only;\ndeterministic ranking"];
"life" -> "r1" [id="B38",label="B38 Attempts, jobs, snapshots and\nsession state"];
"c4" -> "cumulative" [id="B39",label="B39 Cumulative competency reads"];
"review" -> "r1" [id="B40",label="B40 Published state, review audit,\nimmutable evidence"];
"review" -> "r4" [id="B41",label="B41 Recompute concept evidence after\npermitted corrections"];
c7 [label="Grade review controller responsibility\nrouters/admin.py"];
c7 -> review [id="B42",label="B42 Verify grades / publish / retry"];
cumulative [label="Cumulative competency\nPublished evidence; deterministic\naggregation"];
c2 -> ai [id="B43",label="B43 CLO mapping assistance / review"];
c3 -> ai [id="B44",label="B44 Question tagging / difficulty\nsuggestions"];
cumulative -> r1 [id="B45",label="B45 Published session attempts"];
cumulative -> r4 [id="B46",label="B46 Frozen targets and concept context"];
plan [label="Personalized assembly\npersonalized_assessment.py\nFrozen skills / difficulty plan"];
s6 -> plan [id="B47",label="B47 Selected skills / difficulty branch"];
plan -> r1 [id="B48",label="B48 Freeze and serve question plan"];
bp [label="Assessment blueprint policy\nblueprints.py; immutable approved\nversions"];
plan -> bp [id="B49",label="B49 Resolve + freeze approved\narea / band version"];
c1 -> bp [id="B50",label="B50 Publish seeds area / band\nversions"];
bp -> db [id="B51",label="B51 ORM session reads / inserts\nimmutable versions; advisory lock"];
s3 -> llm [id="B52",label="B52 Opt-in translation draft\npreparation"];
subgraph cluster_api { label="FastAPI API process - logical responsibility views, not separate servers"; color="#1F3864";
subgraph cluster_controllers { label="Controller responsibilities"; c0;c1;c2;c3;c4;c5;c6;c7; }
subgraph cluster_services { label="Services"; s0;s1;s2;s3;s4;s5;s6;ai;life;review;cumulative;plan;bp; }
subgraph cluster_repositories { label="Repository responsibilities (shared classes explicitly named)"; r0;r1;r2;r3;r4;r5;r6;cr; }
subgraph cluster_adapters { label="Provider / execution adapters"; llm;runner; }
}
}
