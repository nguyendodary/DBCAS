// Table Relationship - curriculum domain (generated)
// Tables: course_learning_outcome, concept, concept_dependency, concept_competency, clo_concept

Table course_learning_outcome {
  clo_id integer [pk]
  clo_code varchar [not null]
  title varchar [not null]
  description text
  status varchar [not null]
  created_by integer [not null]
  created_at timestamp [not null]
}

Table concept {
  concept_id integer [pk]
  concept_code varchar [not null]
  concept_name varchar [not null]
  subject_area varchar [not null]
  description text
  difficulty_level smallint [not null]
  sql_feature varchar
  keywords text[] [not null]
  learning_objectives text[] [not null]
}

Table concept_dependency {
  concept_id integer [pk]
  prerequisite_concept_id integer [pk]
  created_at timestamp [not null]
}

Table concept_competency {
  competency_id integer [pk]
  session_id integer [not null]
  concept_id integer [not null]
  points_earned numeric [not null]
  points_possible numeric [not null]
  competency_pct numeric [not null]
  below_target boolean [not null]
  computed_at timestamp [not null]
}

Table clo_concept {
  clo_id integer [pk]
  concept_id integer [pk]
  mapping_source varchar [not null]
  status varchar [not null]
  created_at timestamp [not null]
}

// Internal FKs (both ends in this domain)
Ref: clo_concept.clo_id > course_learning_outcome.clo_id [delete: no action, update: no action]
Ref: clo_concept.concept_id > concept.concept_id [delete: no action, update: no action]
Ref: concept_competency.concept_id > concept.concept_id [delete: no action, update: no action]
Ref: concept_dependency.concept_id > concept.concept_id [delete: no action, update: no action]
Ref: concept_dependency.prerequisite_concept_id > concept.concept_id [delete: no action, update: no action]

// Cross-domain FKs (source in this domain; see ERD for full refs)
// concept_competency_session_id_fkey: FOREIGN KEY (session_id) REFERENCES assessment_session(session_id)
// course_learning_outcome_created_by_fkey: FOREIGN KEY (created_by) REFERENCES account(account_id)
