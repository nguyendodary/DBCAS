// Table Relationship - question_bank domain (generated)
// Tables: question, mcq_option, rubric, sql_test_dataset, question_concept, question_candidate, question_translation

Table question {
  question_id integer [pk]
  question_type varchar [not null]
  prompt text [not null]
  reference_answer text
  difficulty_level smallint [not null]
  points numeric [not null]
  source varchar [not null]
  status varchar [not null]
  created_by integer [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  ai_review jsonb
  family_id integer
  version_no integer [not null]
  explanation text
  tags text[] [not null]
  source_refs jsonb [not null]
  original_locale varchar [not null]
}

Table mcq_option {
  option_id integer [pk]
  question_id integer [not null]
  option_label varchar [not null]
  option_text text [not null]
  is_correct boolean [not null]
}

Table rubric {
  rubric_id integer [pk]
  question_id integer [not null]
  level_name varchar [not null]
  min_score numeric [not null]
  max_score numeric [not null]
  criteria text [not null]
}

Table sql_test_dataset {
  dataset_id integer [pk]
  question_id integer [not null]
  dataset_name varchar [not null]
  setup_sql text [not null]
  expected_result jsonb [not null]
  is_edge_case boolean [not null]
}

Table question_concept {
  question_id integer [pk]
  concept_id integer [pk]
  tag_source varchar [not null]
  is_required boolean [not null]
  confirmed boolean [not null]
  review_status varchar [not null]
}

Table question_candidate {
  candidate_id integer [pk]
  concept_id integer [not null]
  question_type varchar [not null]
  payload jsonb [not null]
  validation_status varchar [not null]
  validation_detail jsonb
  promoted_question_id integer
  created_at timestamp [not null]
}

Table question_translation {
  question_id integer [pk]
  locale varchar [pk]
  source_hash varchar [not null]
  prompt text [not null]
  explanation text
  option_texts jsonb [not null]
  rubrics jsonb [not null]
  updated_at timestamp [not null]
}

// Internal FKs (both ends in this domain)
Ref: mcq_option.question_id > question.question_id [delete: no action, update: no action]
Ref: question.family_id > question.question_id [delete: no action, update: no action]
Ref: question_candidate.promoted_question_id > question.question_id [delete: no action, update: no action]
Ref: question_concept.question_id > question.question_id [delete: no action, update: no action]
Ref: question_translation.question_id > question.question_id [delete: cascade, update: no action]
Ref: rubric.question_id > question.question_id [delete: no action, update: no action]
Ref: sql_test_dataset.question_id > question.question_id [delete: no action, update: no action]

// Cross-domain FKs (source in this domain; see ERD for full refs)
// question_created_by_fkey: FOREIGN KEY (created_by) REFERENCES account(account_id)
// question_candidate_concept_id_fkey: FOREIGN KEY (concept_id) REFERENCES concept(concept_id)
// question_concept_concept_id_fkey: FOREIGN KEY (concept_id) REFERENCES concept(concept_id)
