// Table Relationship - practice domain (generated)
// Tables: assessment_session, session_question_plan, session_start_request, attempt, selection_log, adaptive_event

Table assessment_session {
  session_id integer [pk]
  assessment_id integer
  learner_id integer [not null]
  status varchar [not null]
  locale varchar [not null]
  started_at timestamp [not null]
  expires_at timestamp [not null]
  submitted_at timestamp
  config_snapshot jsonb
  result_release_policy varchar [not null]
  release_status varchar [not null]
  start_request_id varchar
  review_revision integer [not null]
  published_at timestamp
  blueprint_id integer
}

Table session_question_plan {
  session_id integer [pk]
  seq_no smallint [pk]
  question_id integer [not null]
}

Table session_start_request {
  learner_id integer [pk]
  request_id varchar [pk]
  session_id integer [not null]
  created_at timestamp [not null]
}

Table attempt {
  attempt_id integer [pk]
  session_id integer [not null]
  question_id integer [not null]
  seq_no smallint [not null]
  selected_option_id integer
  sql_answer text
  essay_answer text
  score numeric
  grading_detail jsonb
  served_at timestamp [not null]
  submitted_at timestamp
  question_snapshot jsonb
  draft_answer jsonb
  draft_revision integer [not null]
  draft_saved_at timestamp
  submission_hash varchar
  grading_status varchar [not null]
  review_revision integer [not null]
}

Table selection_log {
  log_id integer [pk]
  session_id integer [not null]
  seq_no smallint [not null]
  question_id integer [not null]
  is_fallback boolean [not null]
  decision_detail jsonb
  created_at timestamp [not null]
}

Table adaptive_event {
  session_id integer [pk]
  round_no smallint [pk]
  event_type varchar [pk]
  payload jsonb [not null]
  created_at timestamp [not null]
}

// Internal FKs (both ends in this domain)
Ref: adaptive_event.session_id > assessment_session.session_id [delete: no action, update: no action]
Ref: attempt.session_id > assessment_session.session_id [delete: no action, update: no action]
Ref: selection_log.session_id > assessment_session.session_id [delete: no action, update: no action]
Ref: session_question_plan.session_id > assessment_session.session_id [delete: no action, update: no action]
Ref: session_start_request.(session_id, learner_id) > assessment_session.(session_id, learner_id) [delete: no action, update: no action]

// Cross-domain FKs (source in this domain; see ERD for full refs)
// assessment_session_assessment_id_fkey: FOREIGN KEY (assessment_id) REFERENCES assessment(assessment_id)
// assessment_session_blueprint_id_fkey: FOREIGN KEY (blueprint_id) REFERENCES assessment_blueprint(blueprint_id)
// assessment_session_learner_id_fkey: FOREIGN KEY (learner_id) REFERENCES account(account_id)
// attempt_question_id_fkey: FOREIGN KEY (question_id) REFERENCES question(question_id)
// attempt_selected_option_id_fkey: FOREIGN KEY (selected_option_id) REFERENCES mcq_option(option_id)
// selection_log_question_id_fkey: FOREIGN KEY (question_id) REFERENCES question(question_id)
// session_question_plan_question_id_fkey: FOREIGN KEY (question_id) REFERENCES question(question_id)
