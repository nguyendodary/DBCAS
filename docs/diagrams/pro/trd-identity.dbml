// Table Relationship - identity domain (generated)
// Tables: account, account_identity, account_role, account_role_audit, role, user_profile, refresh_session, login_throttle, oauth_handoff, password_reset_token, password_reset_audit

Table account {
  account_id integer [pk]
  email varchar [not null]
  password_hash varchar [not null]
  password_set boolean [not null]
  password_changed_at timestamp
  status varchar [not null]
  can_manage_roles boolean [not null]
  created_at timestamp [not null]
}

Table account_identity {
  identity_id integer [pk]
  account_id integer [not null]
  provider varchar [not null]
  provider_user_id varchar [not null]
  provider_email varchar
  email_verified boolean [not null]
  linked_at timestamp [not null]
}

Table account_role {
  account_id integer [pk]
  role_id integer [pk]
  assigned_at timestamp [not null]
}

Table account_role_audit {
  audit_id bigint [pk]
  action_type varchar [not null]
  actor_account_id integer
  target_account_id integer [not null]
  previous_role varchar
  new_role varchar
  created_at timestamp [not null]
}

Table role {
  role_id integer [pk]
  role_name varchar [not null]
  description text
}

Table user_profile {
  user_id integer [pk]
  account_id integer [not null]
  full_name varchar [not null]
  student_code varchar
  phone_number varchar
  date_of_birth date
}

Table refresh_session {
  token_hash varchar [pk]
  family_id varchar [not null]
  account_id integer [not null]
  credential_version bigint [not null]
  created_at timestamp [not null]
  expires_at timestamp [not null]
  consumed_at timestamp
  revoked_at timestamp
}

Table login_throttle {
  key_hash varchar [pk]
  failures jsonb [not null]
  expires_at timestamp [not null]
}

Table oauth_handoff {
  jti_hash varchar [pk]
  account_id integer [not null]
  expires_at timestamp [not null]
  consumed_at timestamp
  created_at timestamp [not null]
}

Table password_reset_token {
  token_hash varchar [pk]
  account_id integer [not null]
  requested_at timestamp [not null]
  expires_at timestamp [not null]
  used_at timestamp
  revoked_at timestamp
}

Table password_reset_audit {
  audit_id integer [pk]
  account_id integer [not null]
  event varchar [not null]
  created_at timestamp [not null]
}

// Internal FKs (both ends in this domain)
Ref: account_identity.account_id > account.account_id [delete: no action, update: no action]
Ref: account_role.account_id > account.account_id [delete: no action, update: no action]
Ref: account_role.role_id > role.role_id [delete: no action, update: no action]
Ref: account_role_audit.actor_account_id > account.account_id [delete: no action, update: no action]
Ref: account_role_audit.target_account_id > account.account_id [delete: no action, update: no action]
Ref: oauth_handoff.account_id > account.account_id [delete: no action, update: no action]
Ref: password_reset_audit.account_id > account.account_id [delete: no action, update: no action]
Ref: password_reset_token.account_id > account.account_id [delete: no action, update: no action]
Ref: refresh_session.account_id > account.account_id [delete: cascade, update: no action]
Ref: user_profile.account_id > account.account_id [delete: no action, update: no action]
