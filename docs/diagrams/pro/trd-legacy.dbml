// Table Relationship - legacy domain (generated)
// Tables: assessment, assessment_blueprint, assessment_concept, assessment_question

Table assessment [headercolor: #d3d3d3] {
  Note: 'LEGACY - historical exam rows only'
  assessment_id integer [pk]
  title varchar [not null]
  description text
  max_questions smallint [not null]
  duration_min smallint [not null]
  target_mcq smallint [not null]
  target_sql smallint [not null]
  target_essay smallint [not null]
  status varchar [not null]
  created_by integer [not null]
  created_at timestamp [not null]
  family_id integer
  version_no integer [not null]
  result_release_policy varchar [not null]
}

Table assessment_blueprint [headercolor: #d3d3d3] {
  Note: 'LEGACY - historical exam rows only'
  blueprint_id integer [pk]
  assessment_id integer [not null]
  subject_area varchar [not null]
  difficulty_band varchar [not null]
  version_no integer [not null]
  status varchar [not null]
  max_questions smallint [not null]
  target_mcq smallint [not null]
  target_sql smallint [not null]
  target_essay smallint [not null]
  scoring jsonb [not null]
  evidence_types jsonb [not null]
  approval_basis text [not null]
  approved_by integer
  approved_at timestamp [not null]
  created_at timestamp [not null]
}

Table assessment_concept [headercolor: #d3d3d3] {
  Note: 'LEGACY - historical exam rows only'
  assessment_id integer [pk]
  concept_id integer [pk]
  min_difficulty smallint [not null]
  max_difficulty smallint [not null]
  target_pct numeric [not null]
}

Table assessment_question [headercolor: #d3d3d3] {
  Note: 'LEGACY - historical exam rows only'
  assessment_id integer [pk]
  question_id integer [pk]
}

// Internal FKs (both ends in this domain)
Ref: assessment.family_id > assessment.assessment_id [delete: no action, update: no action]
Ref: assessment_blueprint.assessment_id > assessment.assessment_id [delete: cascade, update: no action]
Ref: assessment_concept.assessment_id > assessment.assessment_id [delete: no action, update: no action]
Ref: assessment_question.assessment_id > assessment.assessment_id [delete: cascade, update: no action]

// Cross-domain FKs (source in this domain; see ERD for full refs)
// assessment_created_by_fkey: FOREIGN KEY (created_by) REFERENCES account(account_id)
// assessment_blueprint_approved_by_fkey: FOREIGN KEY (approved_by) REFERENCES account(account_id)
// assessment_concept_concept_id_fkey: FOREIGN KEY (concept_id) REFERENCES concept(concept_id)
// assessment_question_question_id_fkey: FOREIGN KEY (question_id) REFERENCES question(question_id)
