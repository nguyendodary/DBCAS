graph usecases {
graph [rankdir=LR,bgcolor="white",pad="0.5",nodesep="0.5",ranksep="1.2",fontname="Arial",fontsize=22]; node [shape=box,style="rounded,filled",fillcolor="#EFF5FB",color="#1F3864",fontname="Arial",fontsize=13,margin="0.16"]; edge [color="#2E75B6",fontname="Arial",fontsize=11];
graph [label="DBCAS use cases - original goals preserved; reviewed results and preferences added",labelloc=t];
"learner" [shape=box,label="Learner\nRegistration before sign-in",fillcolor="#FFFFFF"];
"admin" [shape=box,label="Administrator\nProvisioning / roles require capability",fillcolor="#FFFFFF"];
"llm" [shape=box,label="LLM provider\nOptional supporting actor",fillcolor="#FFFFFF"];
"google" [shape=box,label="Google OAuth\nOptional supporting actor",fillcolor="#FFFFFF"];
"github" [shape=box,label="GitHub OAuth\nOptional supporting actor",fillcolor="#FFFFFF"];
subgraph cluster_system { label="DBCAS system boundary"; color="#1F3864";
UC01 [shape=ellipse,label="UC01 Register learner account"];
UC02 [shape=ellipse,label="UC02 Login"];
UC03 [shape=ellipse,label="UC03 Logout"];
UC04 [shape=ellipse,label="UC04 Provision administrator accounts"];
UC05 [shape=ellipse,label="UC05 Define CLOs and concept model"];
UC06 [shape=ellipse,label="UC06 Review AI-suggested CLO mappings"];
UC07 [shape=ellipse,label="UC07 Curate validated question bank"];
UC08 [shape=ellipse,label="UC08 Review AI-recommended question tags"];
UC09 [shape=ellipse,label="UC09 Configure adaptive assessments"];
UC10 [shape=ellipse,label="UC10 Oversee AI-generated question candidates"];
UC11 [shape=ellipse,label="UC11 View learner and cohort analytics"];
UC12 [shape=ellipse,label="UC12 Take timed adaptive assessment"];
UC13 [shape=ellipse,label="UC13 Write and run SQL"];
UC14 [shape=ellipse,label="UC14 Answer MCQ and essay questions"];
UC15 [shape=ellipse,label="UC15 Receive grading results and feedback"];
UC16 [shape=ellipse,label="UC16 View competency profile"];
UC17 [shape=ellipse,label="UC17 View competency gap explanations"];
UC18 [shape=ellipse,label="UC18 Review assessment history and evidence"];
UC19 [shape=ellipse,label="UC19 Manage preferences"];
UC20 [shape=ellipse,label="UC20 Verify grades and publish results"];
}
"learner" -- UC01 [id="U01"];
"learner" -- UC02 [id="U02"];
"learner" -- UC03 [id="U03"];
"learner" -- UC12 [id="U04"];
