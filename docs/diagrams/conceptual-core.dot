digraph conceptual {
graph [rankdir=TB,bgcolor="white",pad="0.5",nodesep="0.7",ranksep="1",fontname="Arial",fontsize=22]; node [shape=box,style="rounded,filled",fillcolor="#EFF5FB",color="#1F3864",fontname="Arial",fontsize=13,margin="0.18"]; edge [color="#2E75B6",fontname="Arial",fontsize=11];
graph [label="DBCAS conceptual core - actual relationships; operational detail in full physical schema",labelloc=t];
"Role" [label="Role\nPK: role_id"];
"Account" [label="Account\nPK: account_id"];
"UserProfile" [label="UserProfile\nPK: user_id"];
"Rubric" [label="Rubric\nPK: rubric_id"];
"CourseLearningOutcome" [label="CourseLearningOutcome\nPK: clo_id"];
"Assessment" [label="Assessment\nPK: assessment_id"];
"QuestionCandidate" [label="QuestionCandidate\nPK: candidate_id"];
"Question" [label="Question\nPK: question_id"];
"SQLTestDataset" [label="SQLTestDataset\nPK: dataset_id"];
"Concept" [label="Concept\nPK: concept_id"];
"AssessmentSession" [label="AssessmentSession\nPK: session_id"];
"SelectionLog" [label="SelectionLog\nPK: log_id"];
"MCQOption" [label="MCQOption\nPK: option_id"];
"LLMCache" [label="LLMCache\nPK: cache_id"];
"ConceptCompetency" [label="ConceptCompetency\nPK: competency_id"];
"CompetencyGap" [label="CompetencyGap\nPK: gap_id"];
"Attempt" [label="Attempt\nPK: attempt_id"];
"QuestionTranslation" [label="QuestionTranslation\nPK: question_id + locale"];
"Role" -> "Account" [id="E01",label="E01 assigned via AccountRole"];
"Account" -> "UserProfile" [id="E02",label="E02 has 0..1 profile per account (unique FK)"];
"Account" -> "CourseLearningOutcome" [id="E03",label="E03 defines (creator FK may be null)"];
"Account" -> "Assessment" [id="E04",label="E04 configures (creator FK may be null)"];
"Account" -> "Question" [id="E05",label="E05 authors (creator FK may be null)"];
"Account" -> "AssessmentSession" [id="E06",label="E06 takes"];
"CourseLearningOutcome" -> "Concept" [id="E07",label="E07 maps to via CLOConcept"];
"Assessment" -> "Concept" [id="E08",label="E08 targets via AssessmentConcept"];
"Assessment" -> "AssessmentSession" [id="E10",label="E10 instantiates"];
"QuestionCandidate" -> "Question" [id="E11",label="E11 candidate may promote to 0..1 question; FK not unique"];
"Question" -> "Concept" [id="E12",label="E12 tagged with via QuestionConcept"];
"Question" -> "Rubric" [id="E13",label="E13 graded by"];
"Question" -> "SQLTestDataset" [id="E14",label="E14 tested by"];
"Question" -> "SelectionLog" [id="E15",label="E15 chosen in"];
"Question" -> "MCQOption" [id="E16",label="E16 offers"];
"AssessmentSession" -> "SelectionLog" [id="E17",label="E17 logs"];
"AssessmentSession" -> "Attempt" [id="E18",label="E18 records"];
"AssessmentSession" -> "ConceptCompetency" [id="E19",label="E19 yields"];
"AssessmentSession" -> "CompetencyGap" [id="E20",label="E20 flags"];
"MCQOption" -> "Attempt" [id="E21",label="E21 selected in (nullable selected_option_id)"];
"Concept" -> "ConceptCompetency" [id="E22",label="E22 measured by"];
"Concept" -> "CompetencyGap" [id="E23",label="E23 diagnosed in"];
"Question" -> "Attempt" [id="E24",label="E24 answered in"];
"Concept" -> "QuestionCandidate" [id="E25",label="E25 seeds candidates (concept_id FK)"];
"Concept" -> "Concept" [id="E26",label="E26 prerequisite graph via concept_dependency"];
"Question" -> "QuestionTranslation" [id="E27",label="E27 optional reviewed translations (other locale)"];
}