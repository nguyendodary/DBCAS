digraph "erd_ai" {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=0.55, pad=0.25, bgcolor="white", fontname="Calibri", fontsize=11];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=10, color="#A5A5A5", fillcolor="white", penwidth=1.1, margin="0.10,0.06"];
  edge [fontname="Calibri", fontsize=9, color="#7F7F7F", arrowsize=0.7];
"ai_prompt_content" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#5B9BD5"><font color="white" point-size="10"><b>ai_prompt_content</b> <font point-size="8">(3 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;prompt_record_id</font></td></tr></table>>];
  "ai_prompt_record" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#5B9BD5"><font color="white" point-size="10"><b>ai_prompt_record</b> <font point-size="8">(8 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;prompt_record_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;stage_run_id -&gt; ai_stage_run</font></td></tr></table>>];
  "ai_stage_attempt" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#5B9BD5"><font color="white" point-size="10"><b>ai_stage_attempt</b> <font point-size="8">(10 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;stage_attempt_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;stage_run_id -&gt; ai_stage_run</font></td></tr></table>>];
  "ai_stage_run" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#5B9BD5"><font color="white" point-size="10"><b>ai_stage_run</b> <font point-size="8">(21 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;stage_run_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;session_id -&gt; assessment_session</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;result_version_id -&gt; session_result_version</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;recovery_of_run_id -&gt; ai_stage_run</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;recovery_authorized_by -&gt; account</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;predecessor_validation_id -&gt; ai_stage_validation</font></td></tr></table>>];
  "ai_stage_validation" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#5B9BD5"><font color="white" point-size="10"><b>ai_stage_validation</b> <font point-size="8">(8 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;validation_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;stage_run_id -&gt; ai_stage_run</font></td></tr></table>>];
  "llm_cache" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#5B9BD5"><font color="white" point-size="10"><b>llm_cache</b> <font point-size="8">(7 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;cache_id</font></td></tr></table>>];
  "prompt_access_audit" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#5B9BD5"><font color="white" point-size="10"><b>prompt_access_audit</b> <font point-size="8">(6 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;access_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;prompt_record_id -&gt; ai_prompt_record</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;actor_id -&gt; account</font></td></tr></table>>];
  "retention_purge_audit" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#5B9BD5"><font color="white" point-size="10"><b>retention_purge_audit</b> <font point-size="8">(8 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;purge_audit_id</font></td></tr></table>>];
  "ai_prompt_content" -> "ai_prompt_record" [label="prompt_record_id", color="#7F7F7F"];
  "ai_prompt_record" -> "ai_stage_run" [label="stage_run_id,session_id", color="#7F7F7F"];
  "ai_stage_attempt" -> "ai_stage_run" [label="stage_run_id,session_id", color="#7F7F7F"];
  "ai_stage_run" -> "ai_stage_validation" [label="predecessor_validation_id", color="#7F7F7F"];
  "ai_stage_run" -> "ai_stage_run" [label="recovery_of_run_id", color="#7F7F7F"];
  "ai_stage_validation" -> "ai_stage_run" [label="stage_run_id,session_id", color="#7F7F7F"];
  "prompt_access_audit" -> "ai_prompt_record" [label="prompt_record_id", color="#7F7F7F"];
  "account" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="account\n(identity)"];
  "ai_stage_run" -> "account" [style=dashed, color="#A5A5A5", label="recovery_authorized_by"];
  "prompt_access_audit" -> "account" [style=dashed, color="#A5A5A5", label="actor_id"];
  "assessment_session" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="assessment_session\n(sessions)"];
  "ai_stage_run" -> "assessment_session" [style=dashed, color="#A5A5A5", label="session_id"];
  "session_result_version" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="session_result_version\n(results)"];
  "ai_stage_run" -> "session_result_version" [style=dashed, color="#A5A5A5", label="result_version_id"];
}
