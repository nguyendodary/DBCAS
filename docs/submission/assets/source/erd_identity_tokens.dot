digraph "erd_identity_tokens" {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=0.55, pad=0.25, bgcolor="white", fontname="Calibri", fontsize=11];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=10, color="#A5A5A5", fillcolor="white", penwidth=1.1, margin="0.10,0.06"];
  edge [fontname="Calibri", fontsize=9, color="#7F7F7F", arrowsize=0.7];
"login_throttle" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#4472C4"><font color="white" point-size="10"><b>login_throttle</b> <font point-size="8">(3 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;key_hash</font></td></tr></table>>];
  "oauth_handoff" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#4472C4"><font color="white" point-size="10"><b>oauth_handoff</b> <font point-size="8">(5 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;jti_hash</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;account_id -&gt; account</font></td></tr></table>>];
  "password_reset_audit" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#4472C4"><font color="white" point-size="10"><b>password_reset_audit</b> <font point-size="8">(4 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;audit_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;account_id -&gt; account</font></td></tr></table>>];
  "password_reset_token" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#4472C4"><font color="white" point-size="10"><b>password_reset_token</b> <font point-size="8">(6 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;token_hash</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;account_id -&gt; account</font></td></tr></table>>];
  "refresh_session" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#4472C4"><font color="white" point-size="10"><b>refresh_session</b> <font point-size="8">(8 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;token_hash</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;account_id -&gt; account</font></td></tr></table>>];
  "account" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="account\n(identity)"];
  "oauth_handoff" -> "account" [style=dashed, color="#A5A5A5", label="account_id"];
  "password_reset_audit" -> "account" [style=dashed, color="#A5A5A5", label="account_id"];
  "password_reset_token" -> "account" [style=dashed, color="#A5A5A5", label="account_id"];
  "refresh_session" -> "account" [style=dashed, color="#A5A5A5", label="account_id"];
}
