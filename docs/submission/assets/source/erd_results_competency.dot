digraph "erd_results_competency" {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=0.55, pad=0.25, bgcolor="white", fontname="Calibri", fontsize=11];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=10, color="#A5A5A5", fillcolor="white", penwidth=1.1, margin="0.10,0.06"];
  edge [fontname="Calibri", fontsize=9, color="#7F7F7F", arrowsize=0.7];
"competency_gap" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#70AD47"><font color="white" point-size="10"><b>competency_gap</b> <font point-size="8">(7 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;gap_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;session_id -&gt; assessment_session</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;concept_id -&gt; concept</font></td></tr></table>>];
  "concept_competency" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#70AD47"><font color="white" point-size="10"><b>concept_competency</b> <font point-size="8">(8 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;competency_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;session_id -&gt; assessment_session</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;concept_id -&gt; concept</font></td></tr></table>>];
  "grade_edit_audit" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#70AD47"><font color="white" point-size="10"><b>grade_edit_audit</b> <font point-size="8">(7 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;audit_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;attempt_id -&gt; attempt</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;reviewer_id -&gt; account</font></td></tr></table>>];
  "grade_review" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#70AD47"><font color="white" point-size="10"><b>grade_review</b> <font point-size="8">(8 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;review_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;attempt_id -&gt; attempt</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;reviewer_id -&gt; account</font></td></tr></table>>];
  "result_release_event" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#70AD47"><font color="white" point-size="10"><b>result_release_event</b> <font point-size="8">(6 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;event_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;session_id -&gt; assessment_session</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;reviewer_id -&gt; account</font></td></tr></table>>];
  "account" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="account\n(identity)"];
  "grade_edit_audit" -> "account" [style=dashed, color="#A5A5A5", label="reviewer_id"];
  "grade_review" -> "account" [style=dashed, color="#A5A5A5", label="reviewer_id"];
  "result_release_event" -> "account" [style=dashed, color="#A5A5A5", label="reviewer_id"];
  "assessment_session" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="assessment_session\n(sessions)"];
  "competency_gap" -> "assessment_session" [style=dashed, color="#A5A5A5", label="session_id"];
  "concept_competency" -> "assessment_session" [style=dashed, color="#A5A5A5", label="session_id"];
  "result_release_event" -> "assessment_session" [style=dashed, color="#A5A5A5", label="session_id"];
  "attempt" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="attempt\n(sessions)"];
  "grade_edit_audit" -> "attempt" [style=dashed, color="#A5A5A5", label="attempt_id"];
  "grade_review" -> "attempt" [style=dashed, color="#A5A5A5", label="attempt_id"];
  "concept" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="concept\n(curriculum)"];
  "competency_gap" -> "concept" [style=dashed, color="#A5A5A5", label="concept_id"];
  "concept_competency" -> "concept" [style=dashed, color="#A5A5A5", label="concept_id"];
}
