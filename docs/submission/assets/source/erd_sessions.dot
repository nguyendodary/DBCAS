digraph "erd_sessions" {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=0.55, pad=0.25, bgcolor="white", fontname="Calibri", fontsize=11];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=10, color="#A5A5A5", fillcolor="white", penwidth=1.1, margin="0.10,0.06"];
  edge [fontname="Calibri", fontsize=9, color="#7F7F7F", arrowsize=0.7];
"adaptive_event" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#44546A"><font color="white" point-size="10"><b>adaptive_event</b> <font point-size="8">(5 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;session_id</font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;round_no</font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;event_type</font></td></tr></table>>];
  "assessment_session" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#44546A"><font color="white" point-size="10"><b>assessment_session</b> <font point-size="8">(22 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;session_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;assessment_id -&gt; assessment</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;learner_id -&gt; account</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;blueprint_id -&gt; assessment_blueprint</font></td></tr></table>>];
  "attempt" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#44546A"><font color="white" point-size="10"><b>attempt</b> <font point-size="8">(21 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;attempt_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;session_id -&gt; assessment_session</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;question_id -&gt; question</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;selected_option_id -&gt; mcq_option</font></td></tr></table>>];
  "evaluation_record" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#44546A"><font color="white" point-size="10"><b>evaluation_record</b> <font point-size="8">(10 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;evaluation_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;learner_id -&gt; account</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;session_id -&gt; assessment_session</font></td></tr></table>>];
  "selection_log" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#44546A"><font color="white" point-size="10"><b>selection_log</b> <font point-size="8">(7 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;log_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;session_id -&gt; assessment_session</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;question_id -&gt; question</font></td></tr></table>>];
  "session_final_result" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#44546A"><font color="white" point-size="10"><b>session_final_result</b> <font point-size="8">(14 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;result_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;session_id -&gt; assessment_session</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;reviewer_id -&gt; account</font></td></tr></table>>];
  "session_question_plan" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#44546A"><font color="white" point-size="10"><b>session_question_plan</b> <font point-size="8">(3 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;session_id</font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;seq_no</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;question_id -&gt; question</font></td></tr></table>>];
  "session_start_request" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#44546A"><font color="white" point-size="10"><b>session_start_request</b> <font point-size="8">(5 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;learner_id</font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;request_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;session_id -&gt; assessment_session</font></td></tr></table>>];
  "tab_leave_interval" [shape=plaintext, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#44546A"><font color="white" point-size="10"><b>tab_leave_interval</b> <font point-size="8">(7 cols)</font></font></td></tr><tr><td align="left"><font point-size="8"><b>PK:</b>&#160;leave_event_id</font></td></tr><tr><td align="left"><font point-size="8"><b>FK:</b>&#160;session_id -&gt; assessment_session</font></td></tr></table>>];
  "adaptive_event" -> "assessment_session" [label="session_id", color="#7F7F7F"];
  "attempt" -> "assessment_session" [label="session_id", color="#7F7F7F"];
  "evaluation_record" -> "assessment_session" [label="session_id", color="#7F7F7F"];
  "selection_log" -> "assessment_session" [label="session_id", color="#7F7F7F"];
  "session_final_result" -> "assessment_session" [label="session_id", color="#7F7F7F"];
  "session_question_plan" -> "assessment_session" [label="session_id", color="#7F7F7F"];
  "session_start_request" -> "assessment_session" [label="session_id,learner_id", color="#7F7F7F"];
  "tab_leave_interval" -> "assessment_session" [label="session_id", color="#7F7F7F"];
  "account" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="account\n(identity)"];
  "assessment_session" -> "account" [style=dashed, color="#A5A5A5", label="learner_id"];
  "evaluation_record" -> "account" [style=dashed, color="#A5A5A5", label="learner_id"];
  "session_final_result" -> "account" [style=dashed, color="#A5A5A5", label="reviewer_id"];
  "assessment" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="assessment\n(assessment)"];
  "assessment_session" -> "assessment" [style=dashed, color="#A5A5A5", label="assessment_id"];
  "assessment_blueprint" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="assessment_blueprint\n(assessment)"];
  "assessment_session" -> "assessment_blueprint" [style=dashed, color="#A5A5A5", label="blueprint_id"];
  "mcq_option" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="mcq_option\n(questions)"];
  "attempt" -> "mcq_option" [style=dashed, color="#A5A5A5", label="selected_option_id"];
  "question" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="question\n(questions)"];
  "attempt" -> "question" [style=dashed, color="#A5A5A5", label="question_id"];
  "selection_log" -> "question" [style=dashed, color="#A5A5A5", label="question_id"];
  "session_question_plan" -> "question" [style=dashed, color="#A5A5A5", label="question_id"];
  "session_result_version" [shape=box, style="dashed", fillcolor="#F2F2F2", fontcolor="#555555", label="session_result_version\n(results)"];
  "assessment_session" -> "session_result_version" [style=dashed, color="#A5A5A5", label="session_id,current_result_version_id"];
}
