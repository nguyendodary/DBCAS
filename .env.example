# Copy to .env and fill in. Never commit .env.

# System database (docker compose service: db)
POSTGRES_USER=dbcas
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dbcas
DATABASE_URL=postgresql://dbcas:change_me@localhost:5432/dbcas

# SQL sandbox (docker compose service: sandbox)
SANDBOX_POSTGRES_PASSWORD=change_me_sandbox
SANDBOX_PORT=5433

# Backend
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External AI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
