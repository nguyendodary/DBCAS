# Copy to .env and fill in. Never commit .env.

# System database (docker compose service: db)
POSTGRES_USER=dbcas
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dbcas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dbcas:change_me@localhost:5432/dbcas

# SQL sandbox (docker compose service: sandbox)
SANDBOX_POSTGRES_PASSWORD=change_me_sandbox
SANDBOX_LEARNER_PASSWORD=learner_ro_dev
SANDBOX_PORT=5433
# Backend connections into the sandbox container (never exposed to clients).
SANDBOX_URL=postgresql://learner_ro:learner_ro_dev@localhost:5433/postgres
SANDBOX_ADMIN_URL=postgresql://postgres:change_me_sandbox@localhost:5433/postgres
# Sandbox execution limits (defaults mirror the Architecture document).
SANDBOX_STATEMENT_TIMEOUT_MS=3000
SANDBOX_MAX_ROWS=1000
SANDBOX_MAX_SQL_BYTES=16000
SANDBOX_CONNECT_TIMEOUT_SECONDS=5

# Backend
DEPLOYMENT_MODE=development
JWT_SECRET=change_me_jwt_secret
CORS_ORIGINS=["http://localhost:5173"]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_SESSION_MAX_MINUTES=480
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_TIMEOUT_SECONDS=5
READINESS_DATABASE_TIMEOUT_SECONDS=2
SANDBOX_MAX_RESULT_BYTES=262144
SANDBOX_MAX_CELL_BYTES=16384
SANDBOX_MAX_SETUP_BYTES=65536
SESSION_SWEEP_SECONDS=5
GRADING_JOB_MAX_ATTEMPTS=3
GRADING_JOB_RETRY_SECONDS=30

# Social sign-in (optional) — backend-managed OAuth 2.0 authorization-code
# flow. Secrets stay server-side; never expose them to the frontend.
# Leave a provider's client id empty to disable that button.
#
# FRONTEND_URL is the SPA origin the browser returns to after sign-in. The
# redirect URIs must be registered at the provider and must resolve to this
# backend's /api/v1/auth/oauth/{provider}/callback routes (the Vite dev
# proxy forwards them in development; use a same-origin reverse proxy in
# production so the OAuth cookies stay same-site).
FRONTEND_URL=http://localhost:5173
OAUTH_STATE_TTL_SECONDS=600
OAUTH_HANDOFF_TTL_SECONDS=120
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/github/callback

# External AI — provider-agnostic REST (OpenAI-compatible /chat/completions;
# no vendor SDK). Leave LLM_API_KEY empty to run without AI — AI features
# then fail gracefully with `llm_not_configured` instead of crashing.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional tuning (deterministic grading defaults):
LLM_TEMPERATURE=0.1
LLM_SEED=42
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=0.5
