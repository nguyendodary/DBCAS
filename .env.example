# Copy to .env and fill in. Never commit .env.

# System database (docker compose service: db)
POSTGRES_USER=dbcas
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dbcas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dbcas:change_me@localhost:5432/dbcas

# SQL sandbox (docker compose service: sandbox)
SANDBOX_POSTGRES_PASSWORD=change_me_sandbox
SANDBOX_PORT=5433

# Backend
JWT_SECRET=change_me_jwt_secret
CORS_ORIGINS=["http://localhost:5173"]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External AI — provider-agnostic (any LLM provider reachable via REST; no vendor lock-in)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
