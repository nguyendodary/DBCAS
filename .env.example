# npm start generates .env automatically in a fresh clone; copying this file is optional.
# The running stack reads ONLY <repo>/.env (the directory containing package.json).
# A linked worktree must have its own .env; the DBCAS main checkout is not used.
# Never commit .env. Local Compose overrides database/SMTP service addresses.
LOCAL_API_PORT=18000
LOCAL_WEB_PORT=18080
LOCAL_MAIL_PORT=18025
LOCAL_SMTP_PORT=11025
# Historical independent DN stack (docker-compose.dn.yml).
DN_API_PORT=18000
DN_WEB_PORT=18080

# System database (docker compose service: db)
POSTGRES_USER=dbcas
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dbcas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dbcas:change_me@localhost:5432/dbcas

# SQL sandbox (docker compose service: sandbox)
SANDBOX_POSTGRES_PASSWORD=change_me_sandbox
SANDBOX_LEARNER_PASSWORD=learner_ro_dev
SANDBOX_PORT=5433
# Backend connections into the sandbox container (never exposed to clients).
SANDBOX_URL=postgresql://learner_ro:learner_ro_dev@localhost:5433/postgres
SANDBOX_ADMIN_URL=postgresql://postgres:change_me_sandbox@localhost:5433/postgres
# Sandbox execution limits (defaults mirror the Architecture document).
SANDBOX_STATEMENT_TIMEOUT_MS=3000
SANDBOX_MAX_ROWS=1000
SANDBOX_MAX_SQL_BYTES=16000
SANDBOX_CONNECT_TIMEOUT_SECONDS=5
# shared preserves the team's current stack; DN Compose explicitly uses ephemeral.
SANDBOX_MODE=shared
SANDBOX_CONTAINER_IMAGE=dbcas-sql-ephemeral:local
SANDBOX_CONTAINER_LIFETIME_SECONDS=45
# Socket group on the Docker host, required for DN's trusted development executor.
DN_DOCKER_GID=0

# Backend
DEPLOYMENT_MODE=development
JWT_SECRET=change_me_jwt_secret
CORS_ORIGINS=["http://localhost:5173"]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_SESSION_MAX_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_TIMEOUT_SECONDS=5
READINESS_DATABASE_TIMEOUT_SECONDS=2
SANDBOX_MAX_RESULT_BYTES=262144
SANDBOX_MAX_CELL_BYTES=16384
SANDBOX_MAX_SETUP_BYTES=65536
SESSION_SWEEP_SECONDS=5
GRADING_JOB_MAX_ATTEMPTS=3
GRADING_JOB_RETRY_SECONDS=30

# Social sign-in (optional) — backend-managed OAuth 2.0 authorization-code
# flow. Secrets stay server-side; never expose them to the frontend.
# Empty credentials keep the button visible with an email-sign-in notice.
#
# FRONTEND_URL is the SPA origin the browser returns to after sign-in. The
# redirect URIs must be registered at the provider and must resolve to this
# backend's /api/v1/auth/oauth/{provider}/callback routes (the Vite dev
# proxy forwards them in development; use a same-origin reverse proxy in
# production so the OAuth cookies stay same-site). npm start supplies callbacks
# at http://localhost:18080/api/v1/auth/oauth/{provider}/callback by default.
# For Vite, explicitly set the callback to http://localhost:5173/api/v1/...
# See README for app registration. Credential and callback values stay local.
FRONTEND_URL=http://localhost:5173
OAUTH_STATE_TTL_SECONDS=600
OAUTH_HANDOFF_TTL_SECONDS=120
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Other supported backend knobs (defaults shown; app/init load this file).
# Translation is an API-only opt-in, separate from grading credentials.
QUESTION_TRANSLATION_ENABLED=false
AUTO_GRADE_ESSAYS=false
LLM_PROMPT_VERSION=2026-10-11-v1
PROMPT_BUILDER_MODEL_PATH=
PROMPT_BUILDER_TIMEOUT_SECONDS=8
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_KEYS=10000
SANDBOX_LEARNER_ROLE=learner_ro

# Development-only fault fixtures. Leave these off for ordinary use.
EVALUATION_FAKE_DELAY_SECONDS=0
EVALUATION_FAKE_ERROR=false

# Optional local frontend tools; never put credentials in VITE_* variables.
# Vite host backend default; npm start sets its own web/API proxy.
VITE_API_PROXY=http://localhost:8000
VITE_LOCAL_MAILBOX_URL=http://localhost:18025

# Self-service password recovery. The development inbox is the compose
# service `mailpit` (SMTP 127.0.0.1:1026, UI/API http://127.0.0.1:8026).
# Leave SMTP_HOST or SMTP_FROM empty to disable the reset endpoints with
# password_reset_unavailable; sign-in and registration keep working.
# Production must configure a real relay — Mailpit is development-only.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=DBCAS <no-reply@dbcas.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_IP_RATE_LIMIT_ATTEMPTS=20
PASSWORD_RESET_CONFIRM_RATE_LIMIT_ATTEMPTS=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900

# External AI — provider-agnostic REST (OpenAI-compatible /chat/completions;
# no vendor SDK). Without a key, local essays await instructor grading.
# Local Compose supplies an OpenAI URL/model when these values are blank;
# custom providers must set both. Other optional AI actions report unconfigured.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional tuning (seed support depends on the selected provider/model):
LLM_TEMPERATURE=0.1
LLM_SEED=42
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=0.5
